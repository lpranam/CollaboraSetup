        {
            "name": "Office",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/engine/instdir/program/soffice.bin",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Writer Office",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/engine/instdir/program/soffice.bin",
            "args": ["--writer"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Calc Office",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/engine/instdir/program/soffice.bin",
            "args": ["--calc"],
