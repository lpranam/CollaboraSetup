    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Writer",
            "url": "https://localhost:9980/browser/5bec82ff13/debug.html?file_path=${workspaceFolder}/test/samples/writer-edit.fodt"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Calc",
            "url": "https://localhost:9980/browser/5bec82ff13/debug.html?file_path=${workspaceFolder}/test/samples/calc-edit.fods"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Impress",
            "url": "https://localhost:9980/browser/5bec82ff13/debug.html?file_path=${workspaceFolder}/test/samples/impress-edit.fodp"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Draw",
            "url": "https://localhost:9980/browser/5bec82ff13/debug.html?file_path=${workspaceFolder}/test/samples/draw-edit.odg"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Nextcloud",
            "url": "https://localhost/apps/files/files"
        },
        {
            "name": "kit",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/coolforkit-caps",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerArgs": "-iex \"set sysroot /\""
        },
        {
            "name": "COOLWSD attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/coolwsd",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerArgs": "-iex \"set sysroot /\""
        },
